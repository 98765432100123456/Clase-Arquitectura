# Copie estas variables en .env.local (no se sube al repositorio) con los datos de su app web de Firebase:
# Consola de Firebase > Configuración del proyecto > Tus apps > App web > Configuración del SDK.
# Son identificadores públicos por diseño; la seguridad está en firebase/firestore.rules.
# Sin estas variables la app funciona en "modo demostración" (localStorage), igual que antes.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=cinemax-arquitectura.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=cinemax-arquitectura
VITE_FIREBASE_STORAGE_BUCKET=cinemax-arquitectura.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# true para usar los emuladores locales (firebase emulators:start) en vez del proyecto real
VITE_FIREBASE_EMULADORES=false
